<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Sonic.Controls.DownloadItemView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers">

    <Border Style="{StaticResource ListCardBorderStyle}">
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 16:9 thumbnail with a source badge -->
            <Grid Width="88" Height="50" VerticalAlignment="Center">
                <controls:ArtworkImage
                    DecodeSize="176"
                    Glyph="{x:Bind Item.SourceGlyph, Mode=OneWay}"
                    Source="{x:Bind Item.ThumbnailUrl, Mode=OneWay}" />
            </Grid>

            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    Style="{StaticResource ItemTitleTextStyle}"
                    Text="{x:Bind Item.Title, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind Item.Title, Mode=OneWay}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Item.Subtitle, Mode=OneWay}" />

                <ProgressBar
                    Margin="0,6,0,2"
                    IsIndeterminate="{x:Bind Item.IsIndeterminate, Mode=OneWay}"
                    ShowPaused="{x:Bind Item.CanResume, Mode=OneWay}"
                    Visibility="{x:Bind Item.ShowProgress, Mode=OneWay, Converter={StaticResource BoolToVisibility}}"
                    Value="{x:Bind Item.Progress, Mode=OneWay}" />

                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        FontSize="12"
                        Foreground="{x:Bind Item.Status, Mode=OneWay, Converter={StaticResource DownloadStatusToBrush}}"
                        Glyph="{x:Bind Item.StatusGlyph, Mode=OneWay}" />
                    <TextBlock
                        FontSize="12"
                        Foreground="{x:Bind Item.Status, Mode=OneWay, Converter={StaticResource DownloadStatusToBrush}}"
                        Text="{x:Bind Item.StatusText, Mode=OneWay}" />
                    <TextBlock
                        MaxWidth="560"
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="{x:Bind Item.DetailText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind Item.DetailText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="2">
                <Button
                    AutomationProperties.Name="Pause"
                    Command="{x:Bind Item.PauseCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Pause"
                    Visibility="{x:Bind Item.CanPause, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE769;" />
                </Button>
                <Button
                    AutomationProperties.Name="Resume"
                    Command="{x:Bind Item.ResumeCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Resume"
                    Visibility="{x:Bind Item.CanResume, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    AutomationProperties.Name="Retry"
                    Command="{x:Bind Item.RetryCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Retry"
                    Visibility="{x:Bind Item.CanRetry, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                <Button
                    AutomationProperties.Name="Play"
                    Command="{x:Bind Item.OpenFileCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Open file"
                    Visibility="{x:Bind Item.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                </Button>
                <Button
                    AutomationProperties.Name="Show in folder"
                    Command="{x:Bind Item.OpenFolderCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Show in folder"
                    Visibility="{x:Bind Item.HasFile, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                </Button>
                <Button
                    AutomationProperties.Name="Cancel"
                    Command="{x:Bind Item.CancelCommand}"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="Cancel"
                    Visibility="{x:Bind Item.CanCancel, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <FontIcon FontSize="14" Glyph="&#xE711;" />
                </Button>
                <Button
                    AutomationProperties.Name="More options"
                    Style="{StaticResource IconButtonStyle}"
                    ToolTipService.ToolTip="More options">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem
                                Command="{x:Bind Item.ShowErrorCommand}"
                                Text="Show error details"
                                Visibility="{x:Bind Item.IsFailed, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE946;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Item.OpenSourceCommand}" Text="Open source page">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE774;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Command="{x:Bind Item.OpenFolderCommand}" Text="Open folder">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE8B7;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Command="{x:Bind Item.RemoveCommand}" Text="Remove from list">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
