<?xml version="1.0" encoding="utf-8"?>
<!--
  Identity package ("packaging with external location") for the installed Sonic. It contains no app files:
  it gives Sonic.exe in the install folder a package identity so Windows can list it in the Share menu.
  scripts/release.ps1 fills in the version, packs and signs it; Settings › Desktop integration registers it.
  The Publisher must match the signing certificate and the <msix> element in app.manifest.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 com desktop rescap">
  <Identity Name="Sonic.Identity" Publisher="CN=Sonic Local Signing" Version="$VERSION$" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Sonic</DisplayName>
    <PublisherDisplayName>Sonic</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources>
    <Resource Language="en-us" />
  </Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
  <Applications>
    <Application Id="Sonic" Executable="Sonic.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements
        DisplayName="Sonic"
        Description="Download music and video"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />
      <Extensions>
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Download with Sonic">
            <uap:DataFormat>URI</uap:DataFormat>
            <uap:DataFormat>Text</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>
        <!-- With an identity, Windows App SDK notifications are activated through this COM server. -->
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:ExeServer Executable="Sonic.exe" Arguments="----AppNotificationActivated:" DisplayName="Sonic notifications">
              <com:Class Id="6E1F4E52-3A4B-4C1E-9C55-2B7E5B0D8A11" />
            </com:ExeServer>
          </com:ComServer>
        </com:Extension>
        <desktop:Extension Category="windows.toastNotificationActivation">
          <desktop:ToastNotificationActivation ToastActivatorCLSID="6E1F4E52-3A4B-4C1E-9C55-2B7E5B0D8A11" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
