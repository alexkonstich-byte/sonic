<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sonic.Views.Dialogs.SpotifyImportDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:core="using:Sonic.Core.Models"
    xmlns:helpers="using:Sonic.Helpers"
    Title="Import from Spotify"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    PrimaryButtonClick="OnImportClick"
    PrimaryButtonText="Import">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="540" Spacing="12">
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            Import a public Spotify playlist or album to keep its track list in Sonic. Songs you already have are matched automatically. Spotify audio is never downloaded.
        </TextBlock>

        <InfoBar
            Title="Spotify isn't set up"
            IsClosable="False"
            IsOpen="{x:Bind helpers:Bind.Not(ViewModel.IsConfigured)}"
            Message="Add your Spotify app's Client ID and Client Secret in Settings to import playlists."
            Severity="Warning">
            <InfoBar.ActionButton>
                <Button Click="OnOpenSettingsClick" Content="Open settings" />
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="UrlBox"
                IsEnabled="{x:Bind ViewModel.IsConfigured}"
                KeyDown="OnUrlKeyDown"
                PlaceholderText="https://open.spotify.com/playlist/…"
                Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Command="{x:Bind ViewModel.LoadPreviewCommand}" Content="Preview" IsEnabled="{x:Bind ViewModel.IsConfigured}" />
        </Grid>

        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsImporting, Mode=OneWay}" />

        <InfoBar IsClosable="False" IsOpen="{x:Bind helpers:Bind.IsTextNotEmpty(ViewModel.Error), Mode=OneWay}" Message="{x:Bind ViewModel.Error, Mode=OneWay}" Severity="Error" />

        <Border Style="{StaticResource CardBorderStyle}" Visibility="{x:Bind ViewModel.HasPreview, Mode=OneWay}">
            <StackPanel Spacing="12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <controls:ArtworkImage Width="80" Height="80" DecodeSize="160" Glyph="&#xE90B;" GlyphSize="28" ImageCornerRadius="6" Source="{x:Bind ViewModel.Preview.ImageUrl, Mode=OneWay}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="{x:Bind ViewModel.Preview.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.PreviewDetails, Mode=OneWay}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <ListView MaxHeight="240" ItemsSource="{x:Bind ViewModel.PreviewTracks, Mode=OneWay}" SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:SpotifyTrack">
                            <StackPanel Padding="0,4">
                                <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Name}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                    <Run Text="{x:Bind ArtistText}" /><Run Text=" · " /><Run Text="{x:Bind Album}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </Border>
    </StackPanel>
</ContentDialog>
