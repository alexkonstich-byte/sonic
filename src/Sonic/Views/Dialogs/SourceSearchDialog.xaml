<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sonic.Views.Dialogs.SourceSearchDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels"
    Title="Find a source"
    CloseButtonText="Cancel">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">720</x:Double>
    </ContentDialog.Resources>

    <StackPanel Width="620" Spacing="12">
        <StackPanel>
            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.EntryTitle}" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.EntryDetails}" />
        </StackPanel>
        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap">
            Choose the YouTube upload that matches this song. It will be downloaded with the playlist's track information and added to this playlist. Only download content you're authorized to download.
        </TextBlock>
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox KeyDown="OnQueryKeyDown" Text="{x:Bind ViewModel.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Grid.Column="1" Command="{x:Bind ViewModel.SearchCommand}" Content="Search" />
        </Grid>
        <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsSearching, Mode=OneWay}" />
        <TextBlock Text="{x:Bind ViewModel.Message, Mode=OneWay}" TextWrapping="Wrap" Visibility="{x:Bind helpers:Bind.VisibleIfText(ViewModel.Message), Mode=OneWay}" />
        <ListView
            Height="320"
            IsItemClickEnabled="True"
            ItemClick="OnResultClick"
            ItemsSource="{x:Bind ViewModel.Results}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:SourceResultViewModel">
                    <Grid Padding="0,6" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:ArtworkImage Width="96" Height="54" DecodeSize="192" Glyph="&#xE714;" Source="{x:Bind Thumbnail}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                <Run Text="{x:Bind Channel}" /><Run Text=" · " /><Run Text="{x:Bind DurationText}" />
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource PillBorderStyle}" Visibility="{x:Bind IsGoodMatch}">
                            <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind MatchText}" />
                        </Border>
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind MatchText}" Visibility="{x:Bind helpers:Bind.Collapsed(IsGoodMatch)}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </StackPanel>
</ContentDialog>
