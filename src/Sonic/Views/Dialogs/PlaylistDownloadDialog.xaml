<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="Sonic.Views.Dialogs.PlaylistDownloadDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels"
    Title="Download all"
    CloseButtonText="Cancel"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanDownload, Mode=OneWay}"
    PrimaryButtonClick="OnDownloadClick"
    PrimaryButtonText="{x:Bind ViewModel.DownloadButtonText, Mode=OneWay}">

    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">860</x:Double>
        <x:Double x:Key="ContentDialogMaxHeight">860</x:Double>
    </ContentDialog.Resources>

    <Grid Width="760" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap">
            <Run Text="Songs from " /><Run FontWeight="SemiBold" Text="{x:Bind ViewModel.PlaylistName, Mode=OneWay}" /><Run Text=" are searched on YouTube and saved to the folder below. Songs that are already in that folder (or its subfolders) are linked instead of downloaded again." />
        </TextBlock>

        <!-- Folder -->
        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <controls:SaveToPicker
                    DefaultFolder="{x:Bind ViewModel.DefaultFolder, Mode=OneWay}"
                    Folder="{x:Bind ViewModel.SaveToFolder, Mode=TwoWay}"
                    RecentFolders="{x:Bind ViewModel.RecentFolders, Mode=OneWay}" />
                <TextBlock
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Text="{x:Bind ViewModel.FolderError, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasFolderError, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Top" AutomationProperties.Name="Scan folder" Command="{x:Bind ViewModel.ScanCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Scan folder" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Format -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12">
            <ComboBox MinWidth="170" AutomationProperties.Name="Audio format" Header="Format" ItemsSource="{x:Bind ViewModel.FormatOptions}" SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}" />
            <ComboBox MinWidth="200" AutomationProperties.Name="Audio quality" Header="Quality" ItemsSource="{x:Bind ViewModel.QualityOptions}" SelectedItem="{x:Bind ViewModel.SelectedQuality, Mode=TwoWay}" />
        </StackPanel>

        <!-- Status -->
        <StackPanel Grid.Row="3" Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" TextWrapping="Wrap" />
            <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" />
                <ProgressBar IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}" Value="{x:Bind ViewModel.Progress, Mode=OneWay}" />
            </StackPanel>
            <TextBlock
                Foreground="{ThemeResource SystemFillColorCautionBrush}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsIdle, Mode=OneWay}" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            MaxHeight="360"
            AutomationProperties.Name="Songs"
            ItemsSource="{x:Bind ViewModel.Rows}"
            SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistDownloadRow">
                    <Grid Padding="0,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Artist}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" MaxWidth="320" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Status}" TextTrimming="CharacterEllipsis" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</ContentDialog>
