<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonic.Views.YouTubePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="YouTube" />
                <StackPanel Margin="0,4,0,0" Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" VerticalAlignment="Center" Fill="{ThemeResource SystemFillColorSuccessBrush}" Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.SignInText, Mode=OneWay}" />
                </StackPanel>
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Refresh" Command="{x:Bind ViewModel.RefreshCommand}" IsEnabled="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Sign in -->
        <InfoBar
            Title="Sign in to see your YouTube history"
            Grid.Row="1"
            Margin="36,16,36,0"
            IsClosable="False"
            IsOpen="{x:Bind helpers:Bind.Not(ViewModel.IsSignedIn), Mode=OneWay}"
            Message="Sonic uses your browser's YouTube sign-in: sign in to youtube.com in your browser (Firefox works best), then import its cookies. Your password is never seen by Sonic."
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button AutomationProperties.Name="Import cookies" Command="{x:Bind ViewModel.OpenCookieSettingsCommand}" Content="Import browser cookies" />
            </InfoBar.ActionButton>
        </InfoBar>

        <!-- Feeds + tools -->
        <Grid Grid.Row="2" Margin="32,12,36,4" ColumnSpacing="8" Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="FeedSelector" AutomationProperties.Name="YouTube list" SelectionChanged="OnFeedChanged">
                <SelectorBarItem IsSelected="True" Tag="history" Text="History">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="liked" Text="Liked">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8E1;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="later" Text="Watch later">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE823;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
                <SelectorBarItem Tag="subs" Text="Subscriptions">
                    <SelectorBarItem.Icon>
                        <FontIcon Glyph="&#xE8F2;" />
                    </SelectorBarItem.Icon>
                </SelectorBarItem>
            </SelectorBar>
            <AutoSuggestBox
                Grid.Column="1"
                Width="240"
                VerticalAlignment="Center"
                AutomationProperties.Name="Search this list"
                PlaceholderText="Search this list"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" Visibility="{x:Bind helpers:Bind.VisibleIfPositive(ViewModel.SelectedCount), Mode=OneWay}">
                <TextBlock Margin="8,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" /><Run Text=" selected" />
                </TextBlock>
                <Button AutomationProperties.Name="Download selected as audio" Command="{x:Bind ViewModel.DownloadSelectedCommand}" CommandParameter="audio" Content="Audio" Style="{StaticResource AccentButtonStyle}" />
                <Button AutomationProperties.Name="Download selected as video" Command="{x:Bind ViewModel.DownloadSelectedCommand}" CommandParameter="video" Content="Video" />
            </StackPanel>
        </Grid>

        <!-- List -->
        <ListView
            Grid.Row="3"
            Padding="36,4,36,24"
            ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsSignedIn, Mode=OneWay}">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:FeedItemViewModel">
                    <Border Style="{StaticResource ListCardBorderStyle}">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox MinWidth="0" VerticalAlignment="Center" AutomationProperties.Name="{x:Bind Title}" IsChecked="{x:Bind IsSelected, Mode=TwoWay}" />
                            <Grid Grid.Column="1" Width="120" Height="68">
                                <controls:ArtworkImage DecodeSize="240" Glyph="&#xE714;" GlyphSize="20" ImageCornerRadius="6" Source="{x:Bind Thumbnail}" />
                                <Border
                                    Margin="4"
                                    Padding="4,1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#CC000000"
                                    CornerRadius="3"
                                    Visibility="{x:Bind helpers:Bind.VisibleIfText(DurationText)}">
                                    <TextBlock FontSize="11" Foreground="White" Text="{x:Bind DurationText}" />
                                </Border>
                            </Grid>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                <TextBlock MaxLines="2" Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Title}" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Channel}" />
                                <Border HorizontalAlignment="Left" Padding="6,0" Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}" CornerRadius="4" Visibility="{x:Bind IsDownloaded, Mode=OneWay}">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="Downloaded" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsQueued, Mode=OneWay}">
                                    <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                    <TextBlock FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Text="{x:Bind QueuedAs, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4">
                                <Button AutomationProperties.Name="Preview" Click="OnPreviewClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Preview (stream without downloading)">
                                    <FontIcon FontSize="14" Glyph="&#xE768;" />
                                </Button>
                                <Button AutomationProperties.Name="Download audio" Click="OnAudioClick" ToolTipService.ToolTip="Download as audio">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE8D6;" />
                                        <TextBlock Text="Audio" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="Download video" Click="OnVideoClick" ToolTipService.ToolTip="Download as video">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon FontSize="13" Glyph="&#xE714;" />
                                        <TextBlock Text="Video" />
                                    </StackPanel>
                                </Button>
                                <Button AutomationProperties.Name="More options" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="More">
                                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Click="OnOptionsClick" Text="Choose format, quality and subtitles…">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE713;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Click="OnOpenClick" Text="Open on YouTube">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE774;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListView.ItemTemplate>
            <ListView.Footer>
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    AutomationProperties.Name="Load more"
                    Command="{x:Bind ViewModel.LoadMoreCommand}"
                    Visibility="{x:Bind ViewModel.CanLoadMore, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsLoadingMore, Mode=OneWay}" />
                        <TextBlock Text="Load more" />
                    </StackPanel>
                </Button>
            </ListView.Footer>
        </ListView>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10" Visibility="{x:Bind ViewModel.IsLoading, Mode=OneWay}">
            <ProgressRing HorizontalAlignment="Center" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Loading from YouTube…" />
        </StackPanel>

        <InfoBar
            Grid.Row="3"
            Margin="36,8"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind helpers:Bind.IsTextNotEmpty(ViewModel.Error), Mode=OneWay}"
            Message="{x:Bind ViewModel.Error, Mode=OneWay}"
            Severity="Error" />

        <TextBlock
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="{x:Bind ViewModel.EmptyText, Mode=OneWay}"
            Visibility="{x:Bind helpers:Bind.VisibleIfText(ViewModel.EmptyText), Mode=OneWay}" />
    </Grid>
</Page>
