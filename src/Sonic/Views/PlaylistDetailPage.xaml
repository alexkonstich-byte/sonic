<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonic.Views.PlaylistDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels">

    <Grid MaxWidth="{StaticResource PageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <controls:ArtworkImage
                Width="168"
                Height="168"
                DecodeSize="336"
                Glyph="&#xE90B;"
                GlyphSize="48"
                ImageCornerRadius="8"
                Source="{x:Bind ViewModel.Artwork, Mode=OneWay}" />
            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="4">
                <TextBlock
                    CharacterSpacing="80"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.SourceLabel, Mode=OneWay}" />
                <TextBlock Style="{StaticResource TitleLargeTextBlockStyle}" Text="{x:Bind ViewModel.Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    MaxLines="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind helpers:Bind.VisibleIfText(ViewModel.Description), Mode=OneWay}" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Details, Mode=OneWay}" />
            </StackPanel>
        </Grid>

        <!-- Actions -->
        <StackPanel Grid.Row="1" Margin="36,16,36,8" Spacing="12">
            <CommandBar HorizontalAlignment="Left" Background="Transparent" DefaultLabelPosition="Right" IsDynamicOverflowEnabled="True">
                <AppBarButton Command="{x:Bind ViewModel.PlayAllCommand}" Label="Play">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE768;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.MatchLibraryCommand}" Label="Match with library">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8F1;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.ExportCommand}" Label="Export M3U">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xEDE1;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.RefreshFromSpotifyCommand}" Label="Refresh from Spotify" Visibility="{x:Bind ViewModel.IsSpotify, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE72C;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton Command="{x:Bind ViewModel.OpenInSpotifyCommand}" Label="Open in Spotify" Visibility="{x:Bind ViewModel.IsSpotify, Mode=OneWay}">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE8A7;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton Command="{x:Bind ViewModel.RenameCommand}" Label="Rename">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE8AC;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                    <AppBarButton Command="{x:Bind ViewModel.DeleteCommand}" Label="Delete playlist">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE74D;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsClosable="True"
                IsOpen="{x:Bind ViewModel.ShowSpotifyHint, Mode=OneWay}"
                Message="Songs marked “Not in library” can be matched to files you already have, or you can find a source on YouTube for each one. Sonic reads only track information from Spotify — it never downloads Spotify audio."
                Severity="Informational" />
        </StackPanel>

        <!-- Entries -->
        <ListView
            x:Name="EntryList"
            Grid.Row="2"
            Padding="36,0,36,24"
            AllowDrop="True"
            CanDragItems="True"
            CanReorderItems="True"
            DragItemsCompleted="OnDragItemsCompleted"
            DragItemsStarting="OnDragItemsStarting"
            ItemsSource="{x:Bind ViewModel.Entries}"
            SelectionMode="Single">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="52" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:PlaylistEntryViewModel">
                    <Grid Padding="0,6" Background="Transparent" ColumnSpacing="12" DoubleTapped="OnEntryDoubleTapped">
                        <Grid.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem Click="OnPlayClick" IsEnabled="{x:Bind IsAvailable}" Text="Play">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE768;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnRevealClick" IsEnabled="{x:Bind IsAvailable}" Text="Open file location">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE838;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Click="OnFindSourceClick" IsEnabled="{x:Bind IsMissing}" Text="Find source…">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE721;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Click="OnRemoveClick" Text="Remove from playlist">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Grid.ContextFlyout>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="140" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Index, Mode=OneWay}" TextAlignment="Right" />
                        <controls:ArtworkImage Grid.Column="1" Width="40" Height="40" DecodeSize="80" Source="{x:Bind Artwork}" />
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Opacity="{x:Bind helpers:Bind.Opacity(IsMissing)}">
                            <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Artist}" />
                        </StackPanel>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Album}" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind DurationText}" />
                        <Grid Grid.Column="5" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="6" Visibility="{x:Bind IsAvailable}">
                                <FontIcon FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xE73E;" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="In library" />
                            </StackPanel>
                            <Button Click="OnFindSourceClick" Visibility="{x:Bind IsMissing}" ToolTipService.ToolTip="Not in library. Search YouTube for this song.">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE721;" />
                                    <TextBlock FontSize="12" Text="Find source" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="2"
            MaxWidth="380"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}">
            <FontIcon FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE90B;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="This playlist is empty" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Right-click songs in your library and choose “Add to playlist”."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoToLibraryCommand}" Content="Go to library" />
        </StackPanel>
    </Grid>
</Page>
