<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonic.Views.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <Style x:Key="ColumnHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <MenuFlyout x:Key="TrackMenu" Opening="OnTrackMenuOpening">
            <MenuFlyoutItem Click="OnPlayClick" Text="Play">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnQueueClick" Text="Add to queue">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE90B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnExternalClick" Text="Open with default app">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE8A7;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnRevealClick" Text="Open file location">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnEditClick" Text="Edit metadata">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnFindCoversClick" Text="Find album art">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnFavoriteClick" Text="Favorite">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE734;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutSubItem x:Name="AddToPlaylistMenu" Text="Add to playlist">
                <MenuFlyoutSubItem.Icon>
                    <FontIcon Glyph="&#xE710;" />
                </MenuFlyoutSubItem.Icon>
            </MenuFlyoutSubItem>
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Click="OnRemoveClick" Text="Remove from library">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE894;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
            <MenuFlyoutItem Click="OnDeleteClick" Text="Delete file">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE74D;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid MaxWidth="{StaticResource PageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Margin="{StaticResource PageHeaderMargin}" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Music Library" />
                <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <Button Grid.Column="1" VerticalAlignment="Center" AutomationProperties.Name="Add folder" Command="{x:Bind ViewModel.AddFolderCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE8F4;" />
                    <TextBlock Text="Add folder" />
                </StackPanel>
            </Button>
            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                AutomationProperties.Name="Scan library"
                Command="{x:Bind ViewModel.ScanCommand}"
                IsEnabled="{x:Bind helpers:Bind.Not(ViewModel.IsScanning), Mode=OneWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ProgressRing Width="14" Height="14" IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                    <FontIcon FontSize="14" Glyph="&#xE895;" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
                    <TextBlock Text="Scan" Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.IsScanning), Mode=OneWay}" />
                    <TextBlock Text="Scanning…" Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- View switcher + filters -->
        <Grid Grid.Row="1" Margin="32,12,36,4" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <SelectorBar x:Name="ViewSelector" SelectionChanged="OnViewSelectionChanged">
                <SelectorBarItem IsSelected="True" Tag="Songs" Text="Songs" />
                <SelectorBarItem Tag="Albums" Text="Albums" />
                <SelectorBarItem Tag="Artists" Text="Artists" />
                <SelectorBarItem Tag="Favorites" Text="Favorites" />
                <SelectorBarItem Tag="Recent" Text="Recently added" />
                <SelectorBarItem Tag="Duplicates" Text="Duplicates" />
            </SelectorBar>
            <AutoSuggestBox
                Grid.Column="1"
                Width="240"
                VerticalAlignment="Center"
                PlaceholderText="Search library"
                QueryIcon="Find"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                Grid.Column="2"
                MinWidth="130"
                VerticalAlignment="Center"
                AutomationProperties.Name="Sort by"
                ItemsSource="{x:Bind ViewModel.SortOptions}"
                SelectedItem="{x:Bind ViewModel.SortOption, Mode=TwoWay}"
                Visibility="{x:Bind ViewModel.IsTrackView, Mode=OneWay}" />
            <ToggleButton
                Grid.Column="3"
                Height="32"
                VerticalAlignment="Center"
                AutomationProperties.Name="Sort descending"
                IsChecked="{x:Bind ViewModel.SortDescending, Mode=TwoWay}"
                ToolTipService.ToolTip="Reverse order"
                Visibility="{x:Bind ViewModel.IsTrackView, Mode=OneWay}">
                <FontIcon FontSize="14" Glyph="&#xE8CB;" />
            </ToggleButton>
            <ComboBox
                Grid.Column="4"
                MinWidth="130"
                VerticalAlignment="Center"
                AutomationProperties.Name="Filter by format"
                ItemsSource="{x:Bind ViewModel.FormatFilters}"
                SelectedItem="{x:Bind ViewModel.FormatFilter, Mode=TwoWay}" />
        </Grid>

        <!-- Scope + selection bar -->
        <StackPanel Grid.Row="2" Margin="36,4,36,4" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.ClearScopeCommand}" Visibility="{x:Bind ViewModel.HasScopeFilter, Mode=OneWay}" ToolTipService.ToolTip="Clear filter">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{x:Bind ViewModel.ScopeFilterText, Mode=OneWay}" />
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </StackPanel>
            </Button>
            <StackPanel Orientation="Horizontal" Spacing="4" Visibility="{x:Bind helpers:Bind.VisibleIfPositive(ViewModel.SelectedCount), Mode=OneWay}">
                <TextBlock Margin="4,0,8,0" VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}">
                    <Run Text="{x:Bind ViewModel.SelectedCount, Mode=OneWay}" /><Run Text=" selected" />
                </TextBlock>
                <DropDownButton Content="Add to playlist">
                    <DropDownButton.Flyout>
                        <MenuFlyout x:Name="SelectionPlaylistMenu" Opening="OnSelectionPlaylistMenuOpening" Placement="Bottom" />
                    </DropDownButton.Flyout>
                </DropDownButton>
                <Button Click="OnRemoveSelectionClick" Content="Remove from library" />
                <Button Click="OnDeleteSelectionClick" Content="Delete files" />
                <Button Click="OnClearSelectionClick" Content="Clear selection" Style="{StaticResource SubtleButtonStyle}" />
            </StackPanel>
        </StackPanel>

        <!-- Songs / favorites / recent -->
        <Grid Grid.Row="3" Visibility="{x:Bind ViewModel.IsTrackView, Mode=OneWay}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="48,4,96,4" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="56" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeaderTextStyle}" Text="Title" />
                <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeaderTextStyle}" Text="Artist" />
                <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeaderTextStyle}" Text="Album" />
                <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeaderTextStyle}" Text="Year" />
                <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeaderTextStyle}" Text="Time" />
            </Grid>
            <ListView
                x:Name="TrackList"
                Grid.Row="1"
                CanDragItems="True"
                DragItemsStarting="OnTrackDragStarting"
                Padding="36,0,36,24"
                DoubleTapped="OnTrackDoubleTapped"
                IsMultiSelectCheckBoxEnabled="False"
                ItemsSource="{x:Bind ViewModel.Tracks, Mode=OneWay}"
                SelectionChanged="OnTrackSelectionChanged"
                SelectionMode="Extended">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="52" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TrackViewModel">
                        <Grid Padding="0,6" Background="Transparent" ColumnSpacing="12" ContextFlyout="{StaticResource TrackMenu}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="2*" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="56" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>
                            <controls:ArtworkImage Width="40" Height="40" DecodeSize="80" Source="{x:Bind ArtworkPath}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Title}" ToolTipService.ToolTip="{x:Bind Title}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Details}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Artist}" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Album}" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind YearText}" />
                            <TextBlock Grid.Column="5" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind DurationText}" />
                            <Button
                                Grid.Column="6"
                                AutomationProperties.Name="Favorite"
                                Click="OnFavoriteButtonClick"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTipService.ToolTip="Favorite">
                                <FontIcon FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="{x:Bind FavoriteGlyph, Mode=OneWay}" />
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Albums -->
        <GridView
            Grid.Row="3"
            Padding="36,8,36,24"
            IsItemClickEnabled="True"
            ItemClick="OnAlbumClick"
            ItemsSource="{x:Bind ViewModel.Albums, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsAlbumView, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:AlbumViewModel">
                    <StackPanel Width="164" Padding="0,6,0,8" Spacing="8">
                        <controls:ArtworkImage
                            Width="164"
                            Height="164"
                            DecodeSize="328"
                            Glyph="&#xE93C;"
                            GlyphSize="40"
                            ImageCornerRadius="6"
                            Source="{x:Bind ArtworkPath}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Artist}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Details}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Artists -->
        <GridView
            Grid.Row="3"
            Padding="36,8,36,24"
            IsItemClickEnabled="True"
            ItemClick="OnArtistClick"
            ItemsSource="{x:Bind ViewModel.Artists, Mode=OneWay}"
            SelectionMode="None"
            Visibility="{x:Bind ViewModel.IsArtistView, Mode=OneWay}">
            <GridView.ItemTemplate>
                <DataTemplate x:DataType="vm:ArtistViewModel">
                    <StackPanel Width="148" Padding="0,8" Spacing="8">
                        <controls:ArtworkImage
                            Width="128"
                            Height="128"
                            HorizontalAlignment="Center"
                            DecodeSize="256"
                            Glyph="&#xE77B;"
                            GlyphSize="40"
                            ImageCornerRadius="64"
                            Source="{x:Bind ArtworkPath}" />
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}" />
                            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Details}" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <!-- Duplicates -->
        <ScrollViewer Grid.Row="3" Visibility="{x:Bind ViewModel.IsDuplicateView, Mode=OneWay}">
            <StackPanel Padding="36,8,36,24" Spacing="12">
                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Songs with the same artist, title and length. Review them and delete the copies you don't need." TextWrapping="Wrap" />
                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Duplicates, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="12" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="vm:DuplicateGroupViewModel">
                            <Border Style="{StaticResource CardBorderStyle}">
                                <StackPanel Spacing="8">
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}">
                                        <Run Text="{x:Bind Title}" /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text=" — " /><Run Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Artist}" />
                                    </TextBlock>
                                    <ItemsRepeater ItemsSource="{x:Bind Tracks}">
                                        <ItemsRepeater.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TrackViewModel">
                                                <Grid Padding="0,4" ColumnSpacing="12">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource ItemTitleTextStyle}" Text="{x:Bind Model.FilePath}" ToolTipService.ToolTip="{x:Bind Model.FilePath}" />
                                                        <TextBlock Style="{StaticResource SecondaryTextStyle}">
                                                            <Run Text="{x:Bind Details}" /><Run Text=" · " /><Run Text="{x:Bind DurationText}" /><Run Text=" · added " /><Run Text="{x:Bind DateAddedText}" />
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Click="OnDuplicatePlayClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Play">
                                                        <FontIcon FontSize="14" Glyph="&#xE768;" />
                                                    </Button>
                                                    <Button Grid.Column="2" Click="OnDuplicateRevealClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Open file location">
                                                        <FontIcon FontSize="14" Glyph="&#xE838;" />
                                                    </Button>
                                                    <Button Grid.Column="3" Click="OnDuplicateDeleteClick" Style="{StaticResource IconButtonStyle}" ToolTipService.ToolTip="Delete file">
                                                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsRepeater.ItemTemplate>
                                    </ItemsRepeater>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>

        <!-- Loading / empty states -->
        <ProgressRing Grid.Row="3" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

        <StackPanel
            Grid.Row="3"
            MaxWidth="420"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.IsLibraryEmpty, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE8F1;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Your library is empty" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Add a folder that contains music, or download songs from the Home page. Downloads are added automatically."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Center" Command="{x:Bind ViewModel.AddFolderCommand}" Content="Add a music folder" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind ViewModel.ShowNoResults, Mode=OneWay}">
            <FontIcon FontSize="40" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE721;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Nothing here" />
            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="No songs match the current view and filters." />
        </StackPanel>
    </Grid>
</Page>
