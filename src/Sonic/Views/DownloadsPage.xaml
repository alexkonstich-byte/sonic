<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="Sonic.Views.DownloadsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Sonic.Controls"
    xmlns:helpers="using:Sonic.Helpers"
    xmlns:vm="using:Sonic.ViewModels"
    NavigationCacheMode="Required">

    <Grid MaxWidth="{StaticResource PageMaxWidth}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Margin="{StaticResource PageHeaderMargin}">
            <TextBlock Style="{StaticResource PageTitleTextStyle}" Text="Downloads" />
            <TextBlock Style="{StaticResource PageSubtitleTextStyle}">
                <Run Text="{x:Bind vm:ShellViewModel.ActiveDownloadsText(ViewModel.Store.ActiveCount), Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind ViewModel.ConcurrencyText, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <InfoBar
            Title="Game mode"
            Grid.Row="1"
            Margin="36,8,36,0"
            VerticalAlignment="Top"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.GameMode.IsHolding, Mode=OneWay}"
            Message="{x:Bind ViewModel.GameMode.BannerText, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.IconSource>
                <FontIconSource Glyph="&#xE7FC;" />
            </InfoBar.IconSource>
            <InfoBar.ActionButton>
                <Button AutomationProperties.Name="Download anyway" Command="{x:Bind ViewModel.DownloadAnywayCommand}" Content="Download anyway" />
            </InfoBar.ActionButton>
        </InfoBar>

        <CommandBar
            Grid.Row="1"
            Margin="28,8,28,4"
            Visibility="{x:Bind helpers:Bind.Collapsed(ViewModel.GameMode.IsHolding), Mode=OneWay}"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <AppBarButton Command="{x:Bind ViewModel.PauseAllCommand}" Label="Pause all">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE769;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.ResumeAllCommand}" Label="Resume all">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE768;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.RetryFailedCommand}" IsEnabled="{x:Bind helpers:Bind.IsPositive(ViewModel.Store.FailedCount), Mode=OneWay}" Label="Retry failed">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE72C;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.CancelAllCommand}" IsEnabled="{x:Bind helpers:Bind.IsPositive(ViewModel.Store.ActiveCount), Mode=OneWay}" Label="Cancel all">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE711;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton Command="{x:Bind ViewModel.ClearFinishedCommand}" IsEnabled="{x:Bind helpers:Bind.IsPositive(ViewModel.Store.FinishedCount), Mode=OneWay}" Label="Clear finished">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE894;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton Command="{x:Bind ViewModel.OpenDownloadFolderCommand}" Label="Open folder">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE838;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Command="{x:Bind ViewModel.OpenSettingsCommand}" Label="Download settings">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE713;" />
                    </AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <ListView
            Grid.Row="2"
            Padding="36,4,36,24"
            ItemsSource="{x:Bind ViewModel.Store.Items}"
            SelectionMode="None">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="IsTabStop" Value="False" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemContainerTransitions>
                <TransitionCollection>
                    <AddDeleteThemeTransition />
                    <RepositionThemeTransition />
                </TransitionCollection>
            </ListView.ItemContainerTransitions>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DownloadItemViewModel">
                    <controls:DownloadItemView Item="{x:Bind}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Empty state -->
        <StackPanel
            Grid.Row="2"
            MaxWidth="360"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="8"
            Visibility="{x:Bind helpers:Bind.VisibleIfZero(ViewModel.Store.Items.Count), Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Glyph="&#xE896;" />
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="No downloads yet" />
            <TextBlock
                HorizontalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Paste a link on the Home page to start downloading music."
                TextAlignment="Center"
                TextWrapping="Wrap" />
            <Button Margin="0,8,0,0" HorizontalAlignment="Center" Command="{x:Bind ViewModel.GoHomeCommand}" Content="Go to Home" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
